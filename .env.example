# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Speech-to-text (Deepgram)
DEEPGRAM_API_KEY=

# LLM (Anthropic Claude)
ANTHROPIC_API_KEY=

# Text-to-speech (Cartesia)
CARTESIA_API_KEY=

# Optional slow lane: server-side VLM scene notes. 0 = off (default).
ENABLE_VLM=0
